{
  "name": "mediaradar",
  "private": true,
  "version": "0.0.0",
  "description": "МедиаРадар — платформа региональной медиа-аналитики",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:migrate": "pnpm --filter @mediaradar/db migrate",
    "db:seed": "pnpm --filter @mediaradar/db seed"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.0",
    "globals": "^16.0.0",
    "prettier": "^3.6.0",
    "turbo": "^2.11.6",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.0"
  }
}
