# Переменные production-стека (deploy/docker-compose.prod.yml). Скопируйте в deploy/.env.prod и заполните.
# Секреты генерируйте так: openssl rand -base64 32   (не используйте значения из примера!)

# Домен портала; DNS-запись A/AAAA должна указывать на этот сервер, порты 80/443 открыты
APP_DOMAIN=media.example.ru

POSTGRES_PASSWORD=
APP_API_DB_PASSWORD=
APP_WORKER_DB_PASSWORD=

# Ключ шифрования секретов в БД. ПОТЕРЯ КЛЮЧА = потеря сохранённых токенов и 2FA. Храните копию отдельно от сервера.
APP_ENCRYPTION_KEY=
# Токен доступа к /metrics (для Prometheus)
METRICS_TOKEN=

LOG_LEVEL=info
# Периодический сбор источников и проверка удалений
COLLECT_ENABLED=true
# Синтетический поток демо-материалов от воркера (на боевых данных — false)
DEMO_LIVE=false
