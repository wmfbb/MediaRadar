# МедиаРадар — переменные окружения для локальной разработки.
# `make setup` копирует этот файл в .env; значения ниже рабочие «как есть» с `make deps-up`.
# Для production используйте deploy/.env.prod.example (там все секреты обязательны).

# --- Общее ---
NODE_ENV=development
LOG_LEVEL=info
# Порты. Если какой-то занят другим проектом — поменяйте здесь и перезапустите (`make dev`).
# Для PostgreSQL и Redis после смены порта поправьте и адреса ниже (DATABASE_URL и др.).
WEB_PORT=3000
API_PORT=4000
POSTGRES_PORT=5432
REDIS_PORT=6379
# Публичный адрес портала (ссылки в письмах, проверка Origin для CSRF). Не задан — http://localhost:<WEB_PORT>.
# APP_BASE_URL=

# --- База данных (PostgreSQL 16) ---
# Владелец схемы: только для миграций и сидов (обходит RLS — приложение им не пользуется)
MIGRATE_DATABASE_URL=postgres://mediaradar:mediaradar_dev@localhost:5432/mediaradar
# Прикладные роли без права обхода RLS. Пароли задаются миграцией из переменных ниже.
DATABASE_URL=postgres://app_api:app_api_dev@localhost:5432/mediaradar
WORKER_DATABASE_URL=postgres://app_worker:app_worker_dev@localhost:5432/mediaradar
APP_API_DB_PASSWORD=app_api_dev
APP_WORKER_DB_PASSWORD=app_worker_dev

# --- Redis (очереди BullMQ, события реального времени) ---
REDIS_URL=redis://localhost:6379

# --- API ---
API_HOST=0.0.0.0
# Ключ шифрования секретов в БД (токены, TOTP): openssl rand -base64 32.
# Значение по умолчанию работает ТОЛЬКО вне production.
# APP_ENCRYPTION_KEY=
SESSION_COOKIE_NAME=mr_session
SESSION_TTL_DAYS=14
# Токен для /metrics (в production обязателен): Authorization: Bearer <токен>
# METRICS_TOKEN=
# За обратным прокси (Caddy) включите, чтобы лимиты и аудит видели реальный IP клиента
TRUST_PROXY=false
# Доп. origin'ы для CORS через запятую (обычно не нужны: портал ходит в API через /api на своём origin)
# CORS_ORIGINS=

# --- Сбор данных (Фаза 1) ---
# Воркер сам опрашивает источники по расписанию (RSS и списки страниц) и раз в 10 минут проверяет, не удалены ли
# недавние материалы. Кнопка «Парсить» в разделе «Источники» работает всегда, даже при false.
COLLECT_ENABLED=true

# --- Демо-режим (для тестов и демонстрации без интернета) ---
# Воркер каждые N секунд «публикует» синтетический материал. Нужен вместе с синтетическими данными: make db-demo
DEMO_LIVE=false
DEMO_LIVE_INTERVAL_SEC=8
# Необязательно: порт health-проверки воркера (GET /healthz)
# WORKER_HEALTH_PORT=4100

# --- Веб-портал (Next.js) ---
# Куда проксируются запросы /api/* в dev-режиме (в production это делает Caddy). По умолчанию — порт API_PORT.
# API_ORIGIN=http://localhost:<API_PORT>
# Прямой адрес WebSocket для dev (по умолчанию используется тот же origin: /api/v1/ws)
# NEXT_PUBLIC_WS_URL=ws://localhost:4000/v1/ws
